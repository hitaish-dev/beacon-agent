# ── Beacon Agent — environment ────────────────────────────────────────────────
# Copy to ".env" and fill in whatever you have. Everything degrades gracefully:
# missing keys fall back to the next provider, or to mock mode.

# ── LLM providers (cheapest-first fallback chain) ────────────────────────────
# The agent tries Gemini → OpenAI → Claude, skipping any without a key and
# failing over on quota/rate-limit/auth errors.
# Gemini has a genuinely free tier (Google AI Studio): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OpenAI (pay-as-you-go, gpt-4o-mini is cheap): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic Claude (pay-as-you-go, Haiku is cheap): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Web research ─────────────────────────────────────────────────────────────
# Tavily gives the best results (free tier): https://tavily.com
# Without it, the agent uses free DuckDuckGo scraping, then mock results.
TAVILY_API_KEY=

# ── WhatsApp (Twilio) ────────────────────────────────────────────────────────
# Twilio WhatsApp sandbox: https://console.twilio.com/ → Messaging → Try it out
# Without these, WhatsApp delivery runs in mock mode (logs the message).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox sender (default below is the shared sandbox number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your verified recipient, e.g. whatsapp:+9198XXXXXXXX
TWILIO_WHATSAPP_TO=

# ── Supabase (storage) ───────────────────────────────────────────────────────
# https://supabase.com → Project Settings → API
# Without these, runs are stored in a local JSON file (server/.data/runs.json).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787

# ── Access gate (optional) ───────────────────────────────────────────────────
# Set a password to put the whole app + API behind a login screen. Leave blank
# to keep it open (handy for local dev). Anyone you share the password with can
# sign in. This is enforced on the backend, not just the UI.
APP_PASSWORD=
